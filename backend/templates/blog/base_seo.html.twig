<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}BlackVault Docs{% endblock %}</title>
    <meta name="description" content="{% block description %}Declassified US government documents and FOIA releases.{% endblock %}">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:site_name" content="BlackVault Docs">
    <meta property="og:type" content="article">
    {% block extra_head %}{% endblock %}

    {# Tailwind Play CDN with Typography plugin so prose-* classes are honored. #}
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: { extend: {} }
      }
    </script>
    <style>
      body { font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; background-color: #000; color: #f3f4f6; }
      .font-serif { font-family: "Iowan Old Style", "Apple Garamond", "Baskerville", "Times New Roman", "Droid Serif", Times, serif; }
      .font-mono-doc { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, "Cascadia Mono", "Roboto Mono", monospace; }

      /* ===================== BlackVaultDocs article styling ===================== */
      .bvd-article {
        font-family: "Iowan Old Style", "Apple Garamond", "Baskerville", "Times New Roman", Georgia, serif;
        font-size: 1.0625rem;
        line-height: 1.8;
        color: rgba(255,255,255,0.84);
      }

      /* H2 — declassified-section break: top rule + small uppercase eyebrow effect via heading itself */
      .bvd-article h2 {
        font-size: 1.875rem;
        line-height: 1.25;
        margin-top: 3.25rem;
        margin-bottom: 1.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.14);
        color: #fff;
        font-weight: 700;
        letter-spacing: -0.018em;
        scroll-margin-top: 5rem;
      }
      /* H3 — small uppercase mono callout */
      .bvd-article h3 {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
        font-size: 0.875rem;
        line-height: 1.4;
        margin-top: 2.25rem;
        margin-bottom: 0.875rem;
        color: #fff;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.12);
      }

      /* Paragraphs */
      .bvd-article p { margin: 1.25rem 0; }
      .bvd-article > p:first-of-type { font-size: 1.1875rem; color: rgba(255,255,255,0.94); }
      .bvd-article > p:first-of-type::first-letter {
        font-size: 3.5rem;
        line-height: 0.92;
        float: left;
        font-weight: 800;
        margin: 0.35rem 0.625rem 0 0;
        color: #fff;
        font-family: "Iowan Old Style","Apple Garamond","Baskerville","Times New Roman",serif;
      }

      /* Strong: bright white */
      .bvd-article strong { color: #fff; font-weight: 700; }

      /* Links */
      .bvd-article a {
        color: #fff;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.45);
        transition: border-color 0.15s, background 0.15s;
      }
      .bvd-article a:hover { border-bottom-color: #fff; background: rgba(255,255,255,0.04); }

      /* Tables — mono, declassified-doc grid */
      .bvd-article table {
        width: 100%;
        margin: 2rem 0;
        border-collapse: collapse;
        font-size: 0.9rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
        border: 1px solid rgba(255,255,255,0.18);
      }
      .bvd-article thead th {
        background: rgba(255,255,255,0.06);
        color: #fff;
        font-weight: 600;
        text-align: left;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.18);
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
      }
      .bvd-article tbody td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.84);
        vertical-align: top;
      }
      .bvd-article tbody tr:nth-child(odd) td { background: rgba(255,255,255,0.025); }
      .bvd-article tbody tr:hover td { background: rgba(255,255,255,0.06); color: #fff; }
      .bvd-article tbody tr:last-child td { border-bottom: none; }

      /* Blockquote — declassified stamp callout */
      .bvd-article blockquote {
        margin: 2rem 0;
        padding: 1.25rem 1.5rem;
        background: rgba(255,255,255,0.04);
        border-left: 3px solid #fff;
        color: #fff;
        font-size: 1.0625rem;
        font-style: italic;
      }
      .bvd-article blockquote p { margin: 0; font-style: italic; }
      .bvd-article blockquote p + p { margin-top: 0.625rem; }
      .bvd-article blockquote strong {
        font-style: normal;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-size: 0.8em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
        margin-right: 0.25rem;
      }

      /* Lists */
      .bvd-article ul, .bvd-article ol {
        margin: 1.25rem 0;
        padding-left: 1.5rem;
      }
      .bvd-article li { margin: 0.55rem 0; color: rgba(255,255,255,0.84); }
      .bvd-article ul > li::marker { color: rgba(255,255,255,0.5); }
      .bvd-article ol > li::marker {
        color: rgba(255,255,255,0.7);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
      }
      .bvd-article li > p { margin: 0.25rem 0; }

      /* HR */
      .bvd-article hr { margin: 3rem 0; border: none; border-top: 1px solid rgba(255,255,255,0.15); }

      /* Inline code */
      .bvd-article code:not(pre code) {
        background: rgba(255,255,255,0.08);
        color: #fff;
        padding: 0.125rem 0.375rem;
        font-size: 0.875em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
        border: 1px solid rgba(255,255,255,0.12);
      }

      /* Mobile: scrollable tables */
      @media (max-width: 640px) {
        .bvd-article table { display: block; overflow-x: auto; font-size: 0.825rem; }
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen font-mono">
    <header class="border-b border-white/10 bg-black/80 backdrop-blur-sm sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-3">
            <div class="w-8 h-8 bg-white flex items-center justify-center">
              <span class="text-black font-black text-xl tracking-tighter">BV</span>
            </div>
            <span class="font-bold text-xl tracking-tight text-white">BlackVault<span class="text-white/60 font-normal">Docs</span></span>
          </a>

          <div class="hidden md:flex items-center gap-6">
            <a href="/topics" class="text-sm font-medium text-white/70 hover:text-white transition-colors uppercase tracking-wider">Topics</a>
            <a href="/agencies" class="text-sm font-medium text-white/70 hover:text-white transition-colors uppercase tracking-wider">Agencies</a>
            <a href="/years" class="text-sm font-medium text-white/70 hover:text-white transition-colors uppercase tracking-wider">Timeline</a>
            <a href="/documents" class="text-sm font-medium text-white/70 hover:text-white transition-colors uppercase tracking-wider">Archive</a>
            <a href="/search" class="text-sm font-medium text-white/70 hover:text-white transition-colors uppercase tracking-wider">Search</a>
            <a href="/blog" class="text-sm font-medium text-white hover:text-white transition-colors uppercase tracking-wider border-b border-white">Blog</a>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" class="flex-1">
      {% block body %}{% endblock %}
    </main>

    <footer class="border-t border-white/10 mt-24 py-12 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-white/40 text-sm">
          Declassified documents processed via open intelligence disclosures.<br/>
          Not affiliated with the U.S. Government.
        </p>
        <p class="text-white/30 text-xs mt-4">© {{ "now"|date("Y") }} BlackVault Docs. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
