{% extends "blog/base_seo.html.twig" %}

{% block title %}{{ post.title }} | BlackVault Docs{% endblock %}
{% block description %}{{ post.metaDescription ?? post.title }}{% endblock %}

{% block extra_head %}
    <link rel="canonical" href="https://blackvaultdocs.com/blog/{{ post.slug }}/">
    <meta property="og:url" content="https://blackvaultdocs.com/blog/{{ post.slug }}/">
{% endblock %}

{% block body %}
<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="mb-8 text-sm font-mono">
        <a href="/blog" class="text-white/60 hover:text-white transition-colors uppercase tracking-wider">← All Reports</a>
    </nav>

    <header class="mb-10 pb-8 border-b border-white/10">
        <div class="flex items-center gap-4 text-xs text-white/50 uppercase tracking-widest font-mono mb-5">
            <span class="px-2 py-1 bg-white/8 border border-white/15 text-white">Declassified Analysis</span>
            <span>//</span>
            <time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date("M d, Y") }}</time>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-white leading-[1.05] mb-5 font-serif">
            {{ post.title }}
        </h1>
        {% if post.metaDescription %}
        <p class="text-lg sm:text-xl text-white/70 leading-relaxed font-serif">
            {{ post.metaDescription }}
        </p>
        {% endif %}
    </header>

    <div class="bvd-article">
        {{ post.contentHtml|raw }}
    </div>

    <hr class="border-white/10 mt-16 mb-8" />
    <div class="text-center text-xs text-white/40 font-mono uppercase tracking-widest">
        <p>Source: Open intelligence disclosures · Not affiliated with the U.S. Government</p>
        <p class="mt-3">
            <a href="/blog" class="text-white/60 hover:text-white border-b border-white/30">More reports →</a>
        </p>
    </div>
</article>
{% endblock %}
