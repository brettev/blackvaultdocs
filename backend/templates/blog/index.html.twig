{% extends "blog/base_seo.html.twig" %}

{% block title %}Declassified Analysis Reports | BlackVault Docs{% endblock %}
{% block description %}Editorial analysis of declassified US government records, FOIA releases, and open intelligence disclosures.{% endblock %}

{% block extra_head %}
    <link rel="canonical" href="https://blackvaultdocs.com/blog/">
    <meta property="og:url" content="https://blackvaultdocs.com/blog/">
    <meta property="og:type" content="website">
{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <header class="mb-10 pb-8 border-b border-white/10">
        <p class="text-xs text-white/50 uppercase tracking-widest font-mono mb-4">bvd // reports</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-white leading-[1.05] font-serif">
            Declassified Analysis
        </h1>
        <p class="mt-4 text-lg text-white/70 leading-relaxed font-serif">
            Editorial reports on newly released archives, document anomalies, and cross-collection patterns.
        </p>
    </header>

    {% if posts is empty %}
        <p class="text-white/60 font-serif">No reports published yet.</p>
    {% else %}
        <ul class="space-y-8">
            {% for post in posts %}
            <li class="border-b border-white/10 pb-8">
                <div class="flex items-center gap-3 text-xs text-white/50 uppercase tracking-widest font-mono mb-3">
                    <time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date("M d, Y") }}</time>
                </div>
                <h2 class="text-2xl font-bold text-white font-serif leading-snug">
                    <a href="/blog/{{ post.slug }}/" class="hover:text-red-400 transition-colors">{{ post.title }}</a>
                </h2>
                {% if post.metaDescription %}
                <p class="mt-2 text-white/70 font-serif leading-relaxed">{{ post.metaDescription }}</p>
                {% endif %}
                <p class="mt-3">
                    <a href="/blog/{{ post.slug }}/" class="text-sm font-mono uppercase tracking-wider text-white/60 hover:text-white border-b border-white/30">Read report →</a>
                </p>
            </li>
            {% endfor %}
        </ul>
    {% endif %}

    <p class="mt-12 text-center">
        <a href="/" class="text-xs font-mono uppercase tracking-widest text-white/60 hover:text-white">← Back to archive</a>
    </p>
</div>
{% endblock %}
